# Railway production variables
DATA_DIR=/data
SECRET_KEY=<generate a 64+ character random secret>
SKIP_DEMO_SEED=1
SESSION_COOKIE_SECURE=1
SQLITE_WAL=1

# Set to 1 only once when intentionally initializing a brand-new empty Volume.
# Remove it after the first successful initialization.
ALLOW_NEW_DATABASE=1

# Optional:
# OFFLINE_CREDENTIAL_DAYS=30
